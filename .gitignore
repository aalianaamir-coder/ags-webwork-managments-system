# See https://help.github.com/articles/ignoring-files/ for more about files.

# ============ SECRETS & PRIVATE DATA — never commit ============
CREDENTIALS.txt
CREDENTIALS*.txt
*.pem
*.key
.env
.env.*
!.env.example

# ============ LOCAL DATABASES & RUNTIME STORAGE ============
/db/*.db
/db/*.db-journal
/db/*.db.bak*
/db/*.db.bak-*
/db/backups/
/db/uploads/
/db/avatars/
/db-pg-data/
*.sqlite
*.sqlite3

# ============ USER-PROVIDED / PRIVATE FILES ============
/upload/
/upload*/

# ============ LOGS ============
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============ BUILD ARTIFACTS & DEPENDENCIES ============
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/.build-test/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ============ TEST ISOLATION ============
/tests/.tmp/
/coverage

# ============ SANDBOX / TOOLING ============
.zscripts/
.z-ai-config
.claude
local-*
prompt
test
mini-services/
examples/
/download/
/skills/
.DS_Store
.vercel
